// FINANCEIRO (FIN)
// ============================================================================

model PaymentTransaction {
  id                    String         @id @default(cuid()) @map("id")
  orderId               String         @map("order_id")
  method                PaymentMethod  @map("method")
  gateway               PaymentGateway @map("gateway")
  grossAmount           Decimal        @db.Decimal(12, 2) @map("gross_amount")
  adminFeeRate          Float          @default(0) @map("admin_fee_rate")
  adminFeeAmount        Decimal        @default(0) @db.Decimal(12, 2) @map("admin_fee_amount")
  netAmount             Decimal        @db.Decimal(12, 2) @map("net_amount")
  installments          Int            @default(1) @map("installments")
  anticipationFeeRate   Float?         @map("anticipation_fee_rate")
  anticipationFeeAmount Decimal?       @db.Decimal(12, 2) @map("anticipation_fee_amount")
  anticipatedAt         DateTime?      @map("anticipated_at")
  expectedReceiptDate   DateTime       @map("expected_receipt_date")
  actualReceiptDate     DateTime?      @map("actual_receipt_date")
  status                PaymentStatus  @default(PENDING) @map("status")
  gatewayTxId           String?        @map("gateway_tx_id")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([status])
  @@index([expectedReceiptDate])
  @@map("payment_transactions")
}

model FinancialEntry {
  id             String             @id @default(cuid()) @map("id")
  type           FinancialEntryType @map("type")
  category       String             @map("category")
  description    String             @map("description")
  orderId        String?            @map("order_id")
  cancellationOrderId String?        @unique @map("cancellation_order_id")
  locationId     String?            @map("location_id")
  amount         Decimal            @db.Decimal(12, 2) @map("amount")
  competenceDate DateTime           @map("competence_date")
  dueDate        DateTime?          @map("due_date")
  cashDate       DateTime?          @map("cash_date")
  status         FinancialEntryStatus   @default(PENDING) @map("status")
  paymentMethod  PaymentMethod?         @map("payment_method")
  documentType   FinancialDocumentType? @map("document_type")
  documentNumber String?                @map("document_number")
  costCenterId   String?            @map("cost_center_id")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  order      Order?      @relation("OrderEntries", fields: [orderId], references: [id])
  cancellationOrder Order? @relation("CancellationRefund", fields: [cancellationOrderId], references: [id])
  costCenter CostCenter? @relation(fields: [costCenterId], references: [id])

  @@index([type])
  @@index([competenceDate])
  @@index([costCenterId])
  @@index([deletedAt, competenceDate])
  @@index([deletedAt, type, competenceDate])
  @@map("financial_entries")
}

model CostCenter {
  id         String         @id @default(cuid()) @map("id")
  code       String         @unique @map("code")
  name       String         @map("name")
  type       CostCenterType @map("type")
  locationId String?        @map("location_id")
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  deletedAt  DateTime?      @map("deleted_at")

  location Location? @relation(fields: [locationId], references: [id])

  financialEntries FinancialEntry[]

  @@map("cost_centers")
}

