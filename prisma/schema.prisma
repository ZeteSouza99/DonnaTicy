model Shipment {
  id           String              @id @default(cuid()) @map("id")
  orderId      String              @map("order_id")
  carrier      Carrier             @map("carrier")
  trackingCode String?             @map("tracking_code")
  labelUrl     String?             @map("label_url")
  weight       Float?              @map("weight")
  width        Float?              @map("width")
  height       Float?              @map("height")
  length       Float?              @map("length")
  shippingCost Decimal?            @db.Decimal(12, 2) @map("shipping_cost")
  priority     FulfillmentPriority @map("priority")
  pickedAt     DateTime?           @map("picked_at")
  packedAt     DateTime?           @map("packed_at")
  shippedAt    DateTime?           @map("shipped_at")
  deliveredAt  DateTime?           @map("delivered_at")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@index([trackingCode])
  @@map("shipments")
}

model ReturnRequest {
  id                  String            @id @default(cuid()) @map("id")
  code                String            @unique @map("code")
  orderId             String            @map("order_id")
  customerId          String            @map("customer_id")
  type                ReturnType        @map("type")
  status              ReturnStatus      @default(REQUESTED) @map("status")
  reason              ReturnReason      @map("reason")
  reasonDetail        String?           @map("reason_detail")
  reverseTrackingCode String?           @map("reverse_tracking_code")
  reverseCarrier      Carrier?          @map("reverse_carrier")
  reversePostageUrl   String?           @map("reverse_postage_url")
  postedAt            DateTime?         @map("posted_at")
  receivedAt          DateTime?         @map("received_at")
  inspectedAt         DateTime?         @map("inspected_at")
  inspectedById       String?           @map("inspected_by_id")
  inspectionResult    InspectionResult? @map("inspection_result")
  inspectionNotes     String?           @map("inspection_notes")
  inspectionPhotos    Json              @map("inspection_photos")
  resolution          ReturnResolution? @map("resolution")
  refundAmount        Decimal?          @db.Decimal(12, 2) @map("refund_amount")
  storeCreditAmount   Decimal?          @db.Decimal(12, 2) @map("store_credit_amount")
  exchangeOrderId     String?           @map("exchange_order_id")
  resolvedAt          DateTime?         @map("resolved_at")
  createdAt           DateTime          @default(now()) @map("created_at")
  updatedAt           DateTime          @updatedAt @map("updated_at")
  deletedAt           DateTime?         @map("deleted_at")

  order       Order    @relation(fields: [orderId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  inspectedBy User?    @relation("ReturnInspector", fields: [inspectedById], references: [id])

  items ReturnRequestItem[]

  @@index([orderId])
  @@index([customerId])
  @@index([status])
  @@map("return_requests")
}

model ReturnRequestItem {
  id                String            @id @default(cuid()) @map("id")
  returnRequestId   String            @map("return_request_id")
  orderItemId       String            @map("order_item_id")
  variantId         String            @map("variant_id")
  quantity          Int               @map("quantity")
  reason            ReturnReason      @map("reason")
  inspectionResult  InspectionResult? @map("inspection_result")
  exchangeVariantId String?           @map("exchange_variant_id")

  returnRequest ReturnRequest  @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItem     OrderItem      @relation(fields: [orderItemId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([returnRequestId, orderItemId])
  @@map("return_request_items")
}

// ============================================================================
// CRM & FIDELIDADE
// ============================================================================

model LoyaltyTransaction {
  id          String    @id @default(cuid()) @map("id")
  customerId  String    @map("customer_id")
  points      Int       @map("points")
  type        String    @map("type")
  orderId     String?   @map("order_id")
  description String?   @map("description")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@map("loyalty_transactions")
}

model AutomationTrigger {
  id                  String                  @id @default(cuid()) @map("id")
  name                String                  @map("name")
  description         String?                 @map("description")
  isActive            Boolean                 @default(true) @map("is_active")
  conditionType       AutomationConditionType @map("condition_type")
  conditionConfig     Json                    @map("condition_config")
  actionType          AutomationActionType    @map("action_type")
  actionConfig        Json                    @map("action_config")
  channels            Json                    @map("channels")
  throttleDays        Int                     @default(30) @map("throttle_days")
  maxFiresPerCustomer Int?                    @map("max_fires_per_customer")
  totalFired          Int                     @default(0) @map("total_fired")
  totalConverted      Int                     @default(0) @map("total_converted")
  createdAt           DateTime                @default(now()) @map("created_at")
  updatedAt           DateTime                @updatedAt @map("updated_at")
  deletedAt           DateTime?               @map("deleted_at")

  executions AutomationExecution[]

  @@map("automation_triggers")
}

model AutomationExecution {
  id                String                    @id @default(cuid()) @map("id")
  triggerId         String                    @map("trigger_id")
  customerId        String                    @map("customer_id")
  channel           NotificationChannel       @map("channel")
  status            AutomationExecutionStatus @map("status")
  messageContent    String?                   @map("message_content")
  couponCode        String?                   @map("coupon_code")
  convertedAt       DateTime?                 @map("converted_at")
  conversionOrderId String?                   @map("conversion_order_id")
  sentAt            DateTime                  @default(now()) @map("sent_at")
  deliveredAt       DateTime?                 @map("delivered_at")
  openedAt          DateTime?                 @map("opened_at")
  clickedAt         DateTime?                 @map("clicked_at")

  trigger  AutomationTrigger @relation(fields: [triggerId], references: [id])
  customer Customer          @relation(fields: [customerId], references: [id])

  @@index([triggerId])
  @@index([customerId])
  @@map("automation_executions")
}

// ============================================================================
// NOTAS FISCAIS DE ENTRADA (compra) — preserva dados fiscais da planilha
// ============================================================================

model Invoice {
  id            String   @id @default(cuid()) @map("id")
  number        String   @map("number")
  series        String?  @map("series")
  supplierId    String?  @map("supplier_id")
  supplierName  String   @map("supplier_name")
  issueDate     DateTime @map("issue_date")
  description   String?  @map("description")
  freight       Decimal  @default(0) @db.Decimal(12, 2) @map("freight")
  productsTotal Decimal  @default(0) @db.Decimal(12, 2) @map("products_total")
  discountTotal Decimal  @default(0) @db.Decimal(12, 2) @map("discount_total")
  icmsBaseTotal Decimal  @default(0) @db.Decimal(12, 2) @map("icms_base_total")
  icmsTotal     Decimal  @default(0) @db.Decimal(12, 2) @map("icms_total")
  ipiTotal      Decimal  @default(0) @db.Decimal(12, 2) @map("ipi_total")
  invoiceTotal  Decimal  @default(0) @db.Decimal(12, 2) @map("invoice_total")
  importedAt    DateTime @default(now()) @map("imported_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  supplier Supplier?     @relation(fields: [supplierId], references: [id])
  items    InvoiceItem[]

  @@unique([number, supplierName])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id              String   @id @default(cuid()) @map("id")
  invoiceId       String   @map("invoice_id")
  variantId       String?  @map("variant_id")
  sku             String   @map("sku")
  description     String   @map("description")
  ncm             String?  @map("ncm")
  cfop            String?  @map("cfop")
  csosn           String?  @map("csosn")
  unit            String   @default("UN") @map("unit")
  quantity        Int      @map("quantity")
  unitPrice       Decimal  @db.Decimal(12, 4) @map("unit_price")
  totalPrice      Decimal  @db.Decimal(12, 2) @map("total_price")
  realCost        Decimal  @default(0) @db.Decimal(12, 2) @map("real_cost")
  margin          Float    @default(0) @map("margin")
  costMargin      Decimal  @default(0) @db.Decimal(12, 2) @map("cost_margin")
  commercialValue Decimal  @default(0) @db.Decimal(12, 2) @map("commercial_value")
  discount        Decimal  @default(0) @db.Decimal(12, 2) @map("discount")
  icmsBase        Decimal  @default(0) @db.Decimal(12, 2) @map("icms_base")
  icmsValue       Decimal  @default(0) @db.Decimal(12, 2) @map("icms_value")
  ipiValue        Decimal  @default(0) @db.Decimal(12, 2) @map("ipi_value")
  icmsRate        Float    @default(0) @map("icms_rate")
  ipiRate         Float    @default(0) @map("ipi_rate")
  createdAt       DateTime @default(now()) @map("created_at")

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([invoiceId])
  @@index([sku])
  @@map("invoice_items")
}
