# =============================================================================
# Banco de dados — Supabase Postgres
# Painel Supabase → Project Settings → Database → Connection string
# =============================================================================
#
# Coloque aqui a conexão do banco da DonnaTicy.
#
DATABASE_URL="postgresql://postgres.<projectref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_DATABASE_URL="postgresql://postgres.<projectref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# =============================================================================
# Auth
# =============================================================================
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_USE_A_STRONG_SECRET"
JWT_EXPIRES_IN="8h"
MFA_ENCRYPTION_KEY=""

# =============================================================================
# Cron / manutenção diária
# =============================================================================
CRON_SECRET=""
PENDING_ORDER_TTL_HOURS="48"

# =============================================================================
# App
# =============================================================================
NEXT_PUBLIC_APP_NAME="DonnaTicy ERP"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# =============================================================================
# Marca (whitelabel)
# =============================================================================
NEXT_PUBLIC_BRAND_NAME="DonnaTicy"
NEXT_PUBLIC_BRAND_TAGLINE="Sistema de gestão para moda e operação digital"
NEXT_PUBLIC_BRAND_LOGO="/donnaticy-logo.png"

# =============================================================================
# Feature flags
# =============================================================================
NEXT_PUBLIC_REQUIRE_DISCOUNT_APPROVAL="true"
NEXT_PUBLIC_FEATURE_RECEIPT_PRINTING="false"

# Dados do cabeçalho/rodapé do comprovante (opcionais)
NEXT_PUBLIC_STORE_CNPJ=""
NEXT_PUBLIC_STORE_ADDRESS=""
NEXT_PUBLIC_STORE_PHONE=""
NEXT_PUBLIC_RECEIPT_FOOTER=""

# =============================================================================
# Mensalidade do sistema
# =============================================================================
# NEXT_PUBLIC_SUBSCRIPTION_AMOUNT="100"
# NEXT_PUBLIC_SUBSCRIPTION_DUE_DAY="20"
# NEXT_PUBLIC_SUBSCRIPTION_PIX_KEY=""
# NEXT_PUBLIC_SUBSCRIPTION_PIX_NAME=""
# NEXT_PUBLIC_SUBSCRIPTION_PIX_CITY=""
# NEXT_PUBLIC_SUBSCRIPTION_NOTIFY_DAYS="5"

# =============================================================================
# Seed (opcional)
# =============================================================================
SEED_ADMIN_EMAIL="admin@donnaticy.com"
SEED_ADMIN_PASSWORD=""
SEED_ALL_PASSWORD=""
SEED_DAV_PASSWORD=""
